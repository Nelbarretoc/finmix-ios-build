{
  "appId": "com.th3rdgroup.finmix",
  "appName": "FinMix",
  "webDir": "dist-native",
  "loggingBehavior": "none",
  "server": {
    "androidScheme": "https",
    "errorPath": "webview-update.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "minWebViewVersion": 111
  },
  "ios": {
    "contentInset": "automatic",
    "webContentsDebuggingEnabled": false
  }
}
